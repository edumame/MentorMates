# MentorMates environment template
#
# Copy to .env.local (ignored by Git) and fill in values for YOUR OWN
# development services. Never commit real credentials, and never point a
# local checkout at production services.
#
# The uncommented values below are non-working placeholders that match the
# CI build configuration (.github/workflows/validation.yml). They let
# `npm run build` succeed but do not provide a working database, auth,
# email, AI, chat, or payments backend.
#
# Variables starting with NEXT_PUBLIC_ are exposed to the browser.

# --- Core (required) ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=build-placeholder
# Server-only. Never expose through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=build-placeholder
NEXT_TELEMETRY_DISABLED=1

# Signing secrets for app-issued tokens and invite links. Generate your own
# random values locally (e.g. `openssl rand -hex 32`).
# JWT_SECRET=
# INVITE_HASH_SECRET=

# --- AI (optional) -----------------------------------------------------------
OPENAI_API_KEY=build-placeholder
# OPENAI_RESPONSES_MODEL=
# OPENAI_FILE_SEARCH_VECTOR_STORE_IDS=
# OPENAI_CHAT_ENABLE_WEB_SEARCH=
# OPENAI_CHAT_TOOL_CHOICE=
# OPENAI_CHAT_MAX_ATTACHMENT_INPUTS=
# OPENAI_CHAT_LOG_TOOL_CALLS=
# TYPESAFE_API_KEY=
# JEV_MODEL=
# INTERNAL_JEV_RATE_LIMIT=

# --- Email (optional) --------------------------------------------------------
RESEND_API_KEY=re_build_placeholder
# Comma-separated addresses notified about new bug reports.
# BUG_REPORT_NOTIFY_EMAILS=
# Gmail/Nodemailer sender used by the guide free-access route.
# EMAIL_USER=
# EMAIL_APP_PASSWORD=

# --- Stream chat & video (optional) ------------------------------------------
NEXT_PUBLIC_STREAM_CHAT_API_KEY=build-placeholder
STREAM_CHAT_SECRET_KEY=build-placeholder
NEXT_PUBLIC_STREAM_VIDEO_API_KEY=build-placeholder
# "SCRET" is the current spelling in the source.
STREAM_VIDEO_SCRET_KEY=build-placeholder

# --- Stripe (optional; use test mode only) -----------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GUIDE_STRIPE_PRICE_ID=
# MASTERCLASS_STRIPE_PRICE_ID=

# --- Event import scraper (optional) -----------------------------------------
# EVENT_SCRAPER_API_URL=
# EVENT_SCRAPER_API_TOKEN=
# SCRAPER_ALLOWED_HOSTS=
# TINYFISH_API_KEY=

# --- Other integrations (optional) -------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# INNGEST_EVENT_KEY=
# SCREEN_VISION_WORKER_URL=
# NEXT_PUBLIC_SCREEN_VISION_WORKER_URL=
# SHIPCUE_TOKEN=
# CONTEXTUS_BASE_URL=

# --- Local development only --------------------------------------------------
# Skips login on some organizer views. NEVER set these in any deployed
# environment.
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true
# NEXT_PUBLIC_DEV_AUTH_BYPASS_USER_ID=
